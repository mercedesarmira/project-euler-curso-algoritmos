        "import time\n",
        "import math\n",
        "import statistics\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ------------------------------------------------\n",
        "# Función del problema\n",
        "# ------------------------------------------------\n",
        "def es_primo(n):\n",
        "    if n <= 1:\n",
        "        return False\n",
        "    for i in range(2, n):\n",
        "        if n % i == 0:\n",
        "            return False\n",
        "    return True\n",
        "\n",
        "def generar_permutaciones(numero: str):\n",
        "    permutaciones_totales = []\n",
        "\n",
        "    if len(numero) == 1:\n",
        "        permutaciones_totales.append(numero)\n",
        "        return permutaciones_totales\n",
        "\n",
        "    for i in range(len(numero)):\n",
        "        letra_fija = numero[i]\n",
        "        letras_sobrantes = numero[:i] + numero[i+1:]\n",
        "        sub_permutaciones = generar_permutaciones(letras_sobrantes)\n",
        "\n",
        "        for j in sub_permutaciones:\n",
        "            permutaciones_totales.append(letra_fija + j)\n",
        "    return permutaciones_totales\n",
        "\n",
        "def generar_cadena(n):\n",
        "    cadena = \"\"\n",
        "    k = 1\n",
        "    while k <= n:\n",
        "        cadena += str(k)\n",
        "        k += 1\n",
        "    return cadena\n",
        "\n",
        "def solve_for_n(n):\n",
        "    while n >= 1:\n",
        "        cadena = generar_cadena(n)\n",
        "        permutaciones = sorted(generar_permutaciones(cadena), reverse=True)\n",
        "\n",
        "        mayor_primo = 0\n",
        "        for i in permutaciones:\n",
        "            numero = int(i)\n",
        "            if es_primo(numero):\n",
        "                if numero > mayor_primo:\n",
        "                    mayor_primo = numero\n",
        "                    return mayor_primo\n",
        "        n -= 1\n",
        "    return None\n",
        "\n",
        "# ------------------------------------------------\n",
        "# Medición de tiempos\n",
        "# ------------------------------------------------\n",
        "def medir_tiempo_para_n(n, repeticiones=5):\n",
        "    tiempos = []\n",
        "    for _ in range(repeticiones):\n",
        "        inicio = time.perf_counter()\n",
        "        resultado = solve_for_n(n)\n",
        "        fin = time.perf_counter()\n",
        "        tiempos.append(fin - inicio)\n",
        "    return tiempos\n",
        "\n",
        "# ------------------------------------------------\n",
        "# Ejecutar \n",
        "# ------------------------------------------------\n",
        "valores_n = list(range(1, 10))  \n",
        "repeticiones = 5\n",
        "\n",
        "resultados = {} \n",
        "\n",
        "for n in valores_n:\n",
        "    tiempos = medir_tiempo_para_n(n, repeticiones)\n",
        "    media = statistics.mean(tiempos)\n",
        "    desviacion = statistics.stdev(tiempos)\n",
        "    resultado_encontrado = solve_for_n(n)\n",
        "    resultados[n] = (media, desviacion, tiempos, resultado_encontrado)\n",
        "\n",
        "# ------------------------------------------------\n",
        "# Mostrar tabla de resultados\n",
        "# ------------------------------------------------\n",
        "print(\"\\nTabla de resultados:\")\n",
        "print(\"n\\tMedia (s)\\tDesviación\")\n",
        "for n in valores_n:\n",
        "    prom, desv, _, res = resultados[n]\n",
        "    print(f\"{n}\\t{prom:.6f}\\t{desv:.6f}\")\n",
        "\n",
        "# ------------------------------------------------\n",
        "# Gráfica T(n) vs n\n",
        "# ------------------------------------------------\n",
        "plt.figure(figsize=(8,5))\n",
        "plt.plot(valores_n, [resultados[n][0] for n in valores_n], marker=\"o\")\n",
        "plt.xlabel(\"n (tamaño del pandigital inicial)\")\n",
        "plt.ylabel(\"Tiempo promedio (s)\")\n",
        "plt.title(\"T(n) vs n \")\n",
        "plt.grid(True)\n",
        "plt.xticks(valores_n)\n",
        "plt.show()\n",
        "\n",
        "# ------------------------------------------------\n",
        "# Gráfica log(T) vs log(n)\n",
        "# ------------------------------------------------\n",
        "log_n = [math.log(n) for n in valores_n]\n",
        "log_T = [math.log(resultados[n][0]) for n in valores_n]\n",
        "\n",
        "plt.figure(figsize=(8,5))\n",
        "plt.plot(log_n, log_T, marker=\"o\")\n",
        "plt.xlabel(\"log(n)\")\n",
        "plt.ylabel(\"log(T)\")\n",
        "plt.title(\"log(T) vs log(n)\")\n",
        "plt.grid(True)\n",
        "plt.show()\n"
      ]
